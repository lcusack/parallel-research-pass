# World ID confidential client; save secrets here, never in chat.
# Register at https://auth.world.org/portal using client_secret_basic and Selfie Check accepted accounts.
# A device-only client still requires a registered HTTPS callback.
WORLD_ID_CLIENT_ID=
WORLD_ID_CLIENT_SECRET=
WORLD_ID_CLIENT_AUTH=client_secret_basic
WORLD_ID_ISSUER=https://auth.world.org

# Parallel service-charge budget across ALL accounts and restarts; network fees are extra.
# One answer reserves 1 cent.
# Default 10 cents funds one complete 10-answer demo. Maximum configurable here: $1.
SPONSOR_BUDGET_CENTS=10

# Optional absolute path; default is ~/.tempo/bin/tempo.
# TEMPO_BIN=/absolute/path/to/tempo

# A separate profile simulates another harness session, with a separate World login.
# The human's allowance remains on the shared backend.
RESEARCH_PROFILE=default
