{
  "name": "parallel-research-pass",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "mcp": "node --env-file-if-exists=.env --import tsx src/mcp.ts",
    "cli": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts hosted/test/*.test.ts hosted/test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:hosted": "tsc --noEmit -p hosted/tsconfig.json",
    "deploy": "wrangler deploy --config hosted/wrangler.jsonc --env=",
    "build:staging": "node scripts/build-staging.mjs",
    "deploy:staging": "npm run build:staging && wrangler deploy --config hosted/wrangler.jsonc --env staging",
    "dev:hosted": "wrangler dev --config hosted/wrangler.jsonc",
    "types:hosted": "wrangler types hosted/worker-configuration.d.ts --config hosted/wrangler.jsonc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dompurify": "^3.4.18",
    "jose": "^6.2.17",
    "marked": "^18.2.1",
    "mppx": "0.20.1",
    "viem": "^2.58.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.164.0"
  },
  "description": "World ID research allowance with Parallel and MPP payments",
  "bin": {
    "parallel-research-pass": "bin/parallel-research-pass.mjs"
  },
  "files": [
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcusack/parallel-research-pass.git"
  },
  "license": "MIT"
}
