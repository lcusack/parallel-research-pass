{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "parallel-research-pass",
  "account_id": "8831a5679194f781addc25baa0a0bd46",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_ORIGIN": "https://parallel-research-pass.foundry-world.workers.dev",
    "WORLD_ID_ISSUER": "https://auth.world.org",
    "WORLD_ID_POLICY": "selfie-or-orb",
    "SPONSOR_CALL_CAP": "90",
    "SOURCE_URL": "https://github.com/lcusack/parallel-research-pass"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parallel-research-pass",
      "database_id": "a431ed81-fe83-495f-af74-13afb2744082"
    }
  ],
  "env": {
    "staging": {
      "name": "parallel-research-pass-staging",
      "assets": {
        "directory": ".staging-public",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "vars": {
        "APP_ORIGIN": "https://parallel-research-pass-staging.foundry-world.workers.dev",
        "WORLD_ID_ISSUER": "https://auth.worldcoin.dev",
        "WORLD_ID_POLICY": "selfie",
        "SPONSOR_CALL_CAP": "10",
        "SOURCE_URL": "https://github.com/lcusack/parallel-research-pass"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "parallel-research-pass-staging",
          "database_id": "5993da35-9c04-48a0-9128-faeead9ec17d"
        }
      ]
    }
  }
}
